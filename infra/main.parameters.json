{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deployerPublicIp": {
      "value": "${DEPLOYER_PUBLIC_IP=}"
    },
    "horizonDbVCores": {
      "value": "${HORIZONDB_VCORES=4}"
    },
    "horizonDbReplicaCount": {
      "value": "${HORIZONDB_REPLICA_COUNT=1}"
    }
  }
}
